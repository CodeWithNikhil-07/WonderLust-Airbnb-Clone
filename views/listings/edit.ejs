<!DOCTYPE html>
<html lang="en">
<head>
    <title>Edit Listing</title>
    <link rel="stylesheet" href="/css/style1.css">
</head>
<body>

    <h1>Edit Listing</h1>

    <form action="/listings/<%= listing._id %>?_method=PUT" method="POST">

        <input 
            type="text"
            name="title"
            value="<%= listing.title %>"
        >

        <br><br>

        <textarea name="description"><%= listing.description %></textarea>

        <br><br>

        <input
            type="number"
            name="price"
            value="<%= listing.price %>"
        >

        <br><br>

        <input
            type="text"
            name="location"
            value="<%= listing.location %>"
        >

        <br><br>

        <input
            type="text"
            name="country"
            value="<%= listing.country %>"
        >

        <br><br>

        <button>
            Update Listing
        </button>

    </form>

</body>
</html>