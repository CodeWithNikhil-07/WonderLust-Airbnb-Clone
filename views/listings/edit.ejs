<% layout("/layouts/boilerplate") %>

<div class="max-w-xl mx-auto bg-white shadow-lg rounded-xl p-8 mt-8">

<h1 class="text-3xl font-bold text-center mb-6">
Edit Listing
</h1>

<form
action="/listings/<%= listing._id %>?_method=PUT"
method="POST">

<div class="mb-4">

<label class="block font-medium mb-2">
Title
</label>

<input
type="text"
name="title"
value="<%= listing.title %>"
class="w-full border rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-red-400">

</div>

<div class="mb-4">

<label class="block font-medium mb-2">
Description
</label>

<textarea
name="description"
class="w-full border rounded-lg p-3 h-28 focus:outline-none focus:ring-2 focus:ring-red-400"><%= listing.description %></textarea>

</div>

<div class="mb-4">

<label class="block font-medium mb-2">
Image URL
</label>

<input
type="text"
name="image[url]"
value="<%= listing.image.url %>"
class="w-full border rounded-lg p-3">

</div>

<div class="mb-4">

<label class="block font-medium mb-2">
Price
</label>

<input
type="number"
name="price"
value="<%= listing.price %>"
class="w-full border rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-red-400">

</div>

<div class="mb-4">

<label class="block font-medium mb-2">
Location
</label>

<input
type="text"
name="location"
value="<%= listing.location %>"
class="w-full border rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-red-400">

</div>

<div class="mb-6">

<label class="block font-medium mb-2">
Country
</label>

<input
type="text"
name="country"
value="<%= listing.country %>"
class="w-full border rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-red-400">

</div>

<button
class="w-full bg-blue-500 text-white py-3 rounded-lg hover:bg-blue-600 transition">

Update Listing

</button>

</form>

</div>




























