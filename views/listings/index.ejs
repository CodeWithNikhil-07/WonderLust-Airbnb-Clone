<% layout("/layouts/boilerplate") %>

    <h1 class="text-4xl font-bold text-center my-8">
        All Listings
    </h1>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

        <% for(let listing of allListings){ %>

            <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-xl transition duration-300">

                <img src="<%= listing.image?.url || 'https://images.unsplash.com/photo-1552733407-5d5c46c3bb3b' %>"
                    class="w-full h-56 object-cover">

                <div class="p-5">

                    <h2 class="text-xl font-bold mb-2">

                        <a href="/listings/<%= listing._id %>" class="hover:text-red-500">

                            <%= listing.title %>

                        </a>

                    </h2>

                    <p class="text-gray-600">

                        📍 <%= listing.location %>,
                            <%= listing.country %>

                    </p>

                    <p class="mt-3 font-bold text-lg">

                        ₹ <%= listing.price.toLocaleString("en-IN") %>

                    </p>

                </div>

            </div>

            <% } %>

    </div>