<!DOCTYPE html>
<html lang="en">
<head>
    <title>WonderLust</title>
</head>
<body>

    <h1>All Listings</h1>

    <a href="/listings/new">
        <button>Create New Listing</button>
    </a>

    <ul>
        <% for(let listing of allListings){ %>
            <li>
                <a href="/listings/<%= listing._id %>">
                    <%= listing.title %>
                </a>
            </li>
        <% } %>
    </ul>

</body>
</html>