<% layout("/layouts/boilerplate") %>

<div class="max-w-4xl mx-auto bg-white rounded-xl shadow-lg overflow-hidden mt-8">

<img
src="<%= listing.image.url %>"
class="w-full h-96 object-cover">

<div class="p-8">

<h1 class="text-4xl font-bold mb-5">

<%= listing.title %>

</h1>

<p class="text-gray-700 text-lg mb-5">

<%= listing.description %>

</p>

<p class="text-2xl font-bold mb-3">

₹ <%= listing.price.toLocaleString("en-IN") %>

</p>

<p class="text-gray-600 mb-2">

📍 <%= listing.location %>

</p>

<p class="text-gray-600 mb-6">

🌎 <%= listing.country %>

</p>

<div class="flex gap-4">

<a href="/listings/<%= listing._id %>/edit">

<button
class="bg-blue-500 text-white px-5 py-3 rounded-lg hover:bg-blue-600 transition">

Edit Listing

</button>

</a>

<form
action="/listings/<%= listing._id %>?_method=DELETE"
method="POST">

<button
class="bg-red-500 text-white px-5 py-3 rounded-lg hover:bg-red-600 transition">

Delete Listing

</button>

</form>

</div>

</div>

</div>




































