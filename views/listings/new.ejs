<% layout("/layouts/boilerplate") %>

<div class="max-w-xl mx-auto bg-white shadow-lg rounded-xl p-8 mt-8">

<h1 class="text-3xl font-bold text-center mb-6">
Create New Listing
</h1>

<form action="/listings" method="POST" novalidate>

<div class="mb-4">

<label class="block font-medium mb-2">
Title
</label>

<input
type="text"
name="title"
required
minlength="3"
maxlength="50"
class="peer w-full border rounded-lg p-3">

<p class="hidden peer-invalid:block text-red-500 text-sm mt-1">
Title must be between 3 and 50 characters.
</p>

</div>

<div class="mb-4">

<label class="block font-medium mb-2">
Description
</label>

<textarea
name="description"
required
minlength="10"
class="peer w-full border rounded-lg p-3 h-28">
</textarea>

<p class="hidden peer-invalid:block text-red-500 text-sm mt-1">
Description must contain at least 10 characters.
</p>

</div>

<div class="mb-4">

<label class="block font-medium mb-2">
Image URL
</label>

<input
type="url"
name="image[url]"
class="peer w-full border rounded-lg p-3">

<p class="hidden peer-invalid:block text-red-500 text-sm mt-1">
Please enter a valid image URL.
</p>
</div>

<div class="mb-4">

<label class="block font-medium mb-2">
Price
</label>

<input
type="number"
name="price"
required
min="1"
class="w-full border rounded-lg p-3">

<p class="hidden peer-invalid:block text-red-500 text-sm mt-1">
Price must be greater than 0.
</p>
</div>

<div class="mb-4">

<label class="block font-medium mb-2">
Location
</label>

<input
type="text"
name="location"
required
minlength="2"
class="peer w-full border rounded-lg p-3">

<p class="hidden peer-invalid:block text-red-500 text-sm mt-1">
Location is required.
</p>

</div>

<div class="mb-6">

<label class="block font-medium mb-2">
Country
</label>

<input
type="text"
name="country"
required
minlength="2"
class="peer w-full border rounded-lg p-3">

<p class="hidden peer-invalid:block text-red-500 text-sm mt-1">
Country is required.
</p>

</div>

<button
class="w-full bg-red-500 text-white py-3 rounded-lg hover:bg-red-600 transition">

Create Listing

</button>

</form>

</div>